{
  // Compiles the self-contained audio converter (src/audio/whisperWav.ts) for
  // the Node unit tests and for scripts/whisper-wav-harness.cjs, which loads it
  // unchanged in a hidden Electron window.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist-audio",
    "rootDir": "src/audio",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": []
  },
  "include": ["src/audio/whisperWav.ts"]
}
