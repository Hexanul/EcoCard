{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist-parser-tests",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": []
  },
  "include": [
    "src/config/clinicSettings.ts",
    "src/config/measurementFields.ts",
    "src/config/measurementLimits.ts",
    "src/config/measurementUnits.ts",
    "src/services/medicalParser.ts",
    "src/services/reportState.ts",
    "src/services/romanianNumberParser.ts",
    "src/services/unitNormalizer.ts",
    "src/types/echoReport.ts",
    "src/utils/bmi.ts",
    "src/utils/derivedMeasurements.ts",
    "src/utils/valueChecks.ts"
  ]
}